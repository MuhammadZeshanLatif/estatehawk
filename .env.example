# EstateHawk settings. You can also fill these in the app: Settings > Integrations.
# Gemini AI (offer letters + score explanations). Free key: https://aistudio.google.com  > Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email alerts (Gmail: use an App password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# Slack alerts
SLACK_WEBHOOK_URL=

# SMS / WhatsApp alerts (Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
ALERT_PHONE_TO=

# Login cookies are signed with this. Setup script fills it on the server.
SECRET_KEY=

# Customer email (welcome, password reset, invites, contact form). Render free blocks SMTP, so use Resend over HTTPS.
RESEND_API_KEY=
MAIL_FROM=EstateHawk <support@getestatehawk.com>
SUPPORT_EMAIL=support@getestatehawk.com

# Sign in with Google (Google Cloud > APIs & Services > Credentials > OAuth client, Web application)
# Redirect URI: https://getestatehawk.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
